{
  "name": "microbiz-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node --env-file-if-exists=.env dist/cli.js",
    "probe": "node --env-file-if-exists=.env --import tsx test/probe-models.ts",
    "evaluate": "node --env-file-if-exists=.env --import tsx test/evaluate-expenses.ts",
    "evaluate:operations": "node --import tsx test/evaluate-operations.ts"
  },
  "dependencies": {
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.4",
    "@langchain/langgraph-checkpoint-sqlite": "1.1.1",
    "better-sqlite3": "12.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
